# ──────────────────────────────────────────────────────────────
# 덴트모아 서버 설정 (deploy/.env)
#
# install.sh 가 이 파일을 복사해 deploy/.env 를 만들고 주소를 채워 넣습니다.
# 직접 고칠 일은 거의 없습니다. 고쳤다면 deploy 폴더에서 다시 시작해야 적용됩니다:
#   cd ~/dentmoa/deploy && sudo docker compose up -d
#
# deploy/.env 는 깃(GitHub)에 올라가지 않습니다.
# ──────────────────────────────────────────────────────────────

# 대시보드 주소(도메인). https:// 는 빼고 적습니다.
# 기본값은 서버 IP로 만든 무료 주소입니다. 예: 3-35-123-45.sslip.io
# 내 도메인이 있다면 그 도메인을 적으세요. 도메인의 A 레코드가 이 서버의 IP를 가리켜야 합니다.
DOMAIN=

# 알림 메시지에 넣을 대시보드 주소. https:// + 위의 DOMAIN 과 같게 둡니다.
DENTMOA_BASE_URL=

# 1 = 로그인 쿠키를 https 접속에서만 보냅니다. 그대로 두세요.
DENTMOA_SECURE_COOKIES=1

# (선택) 처음 시작할 때 쓸 대시보드 비밀번호 (8자 이상).
# 비워 두고, 설치 후 처음 접속한 화면에서 정하는 것을 권합니다.
# 이미 비밀번호가 있으면 이 값은 무시됩니다.
# ADMIN_PASSWORD=

# ──────────────────────────────────────────────────────────────
# (선택) 계정 정보
#
# 대시보드의 '계정·연결' 화면에서 입력하는 것을 권합니다. 이 파일에는 적지 않아도 됩니다.
# 여기에 적으면 화면에 입력한 값보다 이 값이 우선하고, 화면에서는 바꿀 수 없게 됩니다.
# 쓰려면 줄 맨 앞의 # 을 지우고 값을 적습니다.
# ──────────────────────────────────────────────────────────────

# 모어덴 (카카오 로그인이 아닌 아이디·비밀번호 로그인)
# MOREDEN_ID=
# MOREDEN_PW=

# 덴트포토
# DENTPHOTO_ID=
# DENTPHOTO_PW=

# 텔레그램 (docs/3-텔레그램-설정.md)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# 메일 (docs/4-메일-설정.md). Gmail 은 smtp.gmail.com, 587, 16자리 앱 비밀번호
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_TO=
